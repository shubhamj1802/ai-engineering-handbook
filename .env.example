# ---------------------------------------------------------------------------
# AI Engineering Handbook - environment template
#
# LOCAL:      copy to .env.local and fill in. NEVER commit .env.local.
# PRODUCTION: set these in the Vercel dashboard (Settings -> Environment
#             Variables). Never put real values in this file - it is committed.
# ---------------------------------------------------------------------------

# Required by Auth.js to sign session cookies. Use a DIFFERENT value in
# production from the one you use locally.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-random-32-byte-string

# The canonical URL of this app (NEXTAUTH_URL is accepted as an older alias).
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app  (or your custom domain)
AUTH_URL=http://localhost:3000

# Used for sitemap.xml, robots.txt and Open Graph tags. Set this in production
# to the domain you actually want indexed, or per-deployment preview URLs leak
# into search results.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gmail / Google sign-in -------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Application type:             Web application
#   Authorised JavaScript origins: http://localhost:3000
#                                  https://your-app.vercel.app
#   Authorised redirect URIs:      http://localhost:3000/api/auth/callback/google
#                                  https://your-app.vercel.app/api/auth/callback/google
#
# For a PUBLIC site the OAuth consent screen must be published ("In production"),
# not left in Testing mode - otherwise only listed test users can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: restrict sign-in to one Google Workspace domain (e.g. example.com).
# Leave empty to allow any Gmail/Google account. Keep empty for a public site.
ALLOWED_EMAIL_DOMAIN=

# --- Progress storage -------------------------------------------------------
# PRODUCTION: a Postgres connection string (Neon's free tier is ample).
#   https://neon.tech -> create project -> copy the pooled connection string.
# The `progress` table is created automatically on first use.
# Leave EMPTY locally to fall back to JSON files under .data/progress.
DATABASE_URL=

# Only used by the local file fallback, when DATABASE_URL is empty.
PROGRESS_DIR=.data/progress
